+    private boolean hasVulkanDriver() {
+        return GraphicsDrivers.isVulkanDriver(graphicsDriver[0]);
+    }
+
+    private void normalizeGraphicsSettings() {
+        int vulkanVersion = GraphicsDevice.vulkanVersion(this);
+        if (GraphicsDrivers.TURNIP.equals(graphicsDriver[0])) {
+            String renderer = GPUHelper.glGetRenderer(this).toLowerCase(Locale.ROOT);
+            if (!renderer.isEmpty() && !renderer.contains("adreno")) {
+                graphicsDriver[0] = vulkanVersion > 0 ? GraphicsDrivers.VORTEK : GraphicsDrivers.NONE;
+                graphicsDriverConfig[0] = new KeyValueSet();
+            }
+        }
+        if (GraphicsDrivers.VORTEK.equals(graphicsDriver[0]) && vulkanVersion == 0) {
+            graphicsDriver[0] = GraphicsDrivers.NONE;
+        }
+        if (!hasVulkanDriver()) {
+            if (GraphicsDrivers.ZINK.equals(graphicsDriver[1])) graphicsDriver[1] = GraphicsDrivers.VIRGL;
+            if (DXWrappers.DXVK.equals(dxwrapper)) {
+                dxwrapper = DXWrappers.WINED3D;
+                dxwrapperConfig[0] = new KeyValueSet();
+            }
+            if ("vulkan".equals(dxwrapperConfig[0].get("renderer"))) dxwrapperConfig[0].put("renderer", "gl");
+            if (DXWrappers.D7VK.equals(dxwrapperConfig[0].get("ddrawWrapper"))) {
+                dxwrapperConfig[0].put("ddrawWrapper", DXWrappers.WINED3D);
+            }
+        }
+        if (DXWrappers.WINED3D.equals(dxwrapper) && GraphicsDrivers.NONE.equals(graphicsDriver[1]) &&
+                !"vulkan".equals(dxwrapperConfig[0].get("renderer"))) {
+            dxwrapperConfig[0].put("renderer", "gdi");
+        }
+    }
+
+    private boolean supportsModernWrappers() {
+        if (GraphicsDrivers.TURNIP.equals(graphicsDriver[0])) {
+            String turnip = graphicsDriverConfig[0].get("version", DefaultVersion.TURNIP);
+            return GPUHelper.vkMakeVersion(turnip) >= GPUHelper.vkMakeVersion(26, 0, 3);
+        }
+        if (GraphicsDevice.vulkanVersion(this) < GPUHelper.VK_API_VERSION_1_3) return false;
+        List<String> extensions = Arrays.asList(GPUHelper.vkGetDeviceExtensions());
+        return extensions.containsAll(Arrays.asList("VK_KHR_maintenance5", "VK_KHR_maintenance6",
+            "VK_KHR_load_store_op_none", "VK_EXT_depth_clip_enable", "VK_EXT_robustness2",
+            "VK_EXT_transform_feedback"));
+    }
+
+    private boolean supportsVulkan13() {
+        if (GraphicsDrivers.TURNIP.equals(graphicsDriver[0])) {
+            String turnip = graphicsDriverConfig[0].get("version", DefaultVersion.TURNIP);
+            return !turnip.equals("24.1.0") && !turnip.equals("25.0.0");
+        }
+        return hasVulkanDriver() && GraphicsDevice.vulkanVersion(this) >= GPUHelper.VK_API_VERSION_1_3;
     }
 
