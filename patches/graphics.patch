+++ b/app/src/main/java/com/winlator/container/GraphicsProfile.java
@@ -0,0 +1,65 @@
+package com.winlator.container;
+
+import com.winlator.core.KeyValueSet;
+
+public enum GraphicsProfile {
+    AUTO, VULKAN, VIRGL, GLADIO, ZINK, RETRO, SAFE;
+
+    public static final int RECOMMENDED_FRAME_CAP = -1;
+    private static final int VULKAN_1_1 = (1 << 22) | (1 << 12);
+    private static final int VULKAN_1_2 = (1 << 22) | (2 << 12);
+    private static final int VULKAN_1_3 = (1 << 22) | (3 << 12);
+
+    public boolean isAvailable(int vulkanVersion) {
+        if (this == VULKAN) return vulkanVersion >= VULKAN_1_1;
+        if (this == ZINK) return vulkanVersion >= VULKAN_1_2;
+        return true;
+    }
+
+    public Settings resolve(int vulkanVersion, int adrenoModel, boolean lowMemory, int frameCap) {
+        boolean turnip = adrenoModel >= 600 && adrenoModel < 800;
+        GraphicsProfile profile = this;
+        if (profile == AUTO) {
+            profile = (turnip || (!lowMemory && vulkanVersion >= VULKAN_1_3)) ? VULKAN : VIRGL;
+        }
+        if (!profile.isAvailable(vulkanVersion)) profile = VIRGL;
+        String vulkan = turnip ? GraphicsDrivers.TURNIP : GraphicsDrivers.VORTEK;
+        String resolution = lowMemory ? "960x540" : "1280x720";
+        switch (profile) {
+            case VULKAN:
+                KeyValueSet dxvk = new KeyValueSet();
+                if (lowMemory) dxvk.put("maxDeviceMemory", 1024).put("compilerThreads", 2);
+                if (frameCap == RECOMMENDED_FRAME_CAP) frameCap = lowMemory ? 30 : 60;
+                if (frameCap > 0) dxvk.put("framerate", frameCap);
+                return new Settings(vulkan, turnip ? GraphicsDrivers.GLADIO : GraphicsDrivers.VIRGL,
+                    DXWrappers.DXVK, dxvk.toString(), resolution);
+            case ZINK:
+                return new Settings(vulkan, GraphicsDrivers.ZINK, DXWrappers.WINED3D, "", resolution);
+            case GLADIO:
+                return new Settings(GraphicsDrivers.NONE, GraphicsDrivers.GLADIO, DXWrappers.WINED3D, "", resolution);
+            case RETRO:
+                return new Settings(GraphicsDrivers.NONE, GraphicsDrivers.GLADIO, DXWrappers.WINED3D,
+                    "ddrawWrapper=cnc-ddraw", "960x540");
+            case SAFE:
+                return new Settings(GraphicsDrivers.NONE, GraphicsDrivers.NONE, DXWrappers.WINED3D,
+                    "renderer=gdi", "800x600");
+            default:
+                return new Settings(GraphicsDrivers.NONE, GraphicsDrivers.VIRGL, DXWrappers.WINED3D,
+                    lowMemory ? "VideoMemorySize=1024" : "", resolution);
+        }
+    }
+
+    public static final class Settings {
+        public final String drivers;
+        public final String wrapper;
+        public final String wrapperConfig;
+        public final String resolution;
+
+        private Settings(String vulkan, String openGL, String wrapper, String wrapperConfig, String resolution) {
+            this.drivers = vulkan+","+openGL;
+            this.wrapper = wrapper;
+            this.wrapperConfig = wrapperConfig;
+            this.resolution = resolution;
+        }
+    }
+}
