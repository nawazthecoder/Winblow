@@ -0,0 +1,94 @@
+package com.winlator.contentdialog;
+
+import android.app.Activity;
+import android.view.View;
+import android.widget.AdapterView;
+import android.widget.ArrayAdapter;
+import android.widget.CheckBox;
+import android.widget.Spinner;
+import android.widget.TextView;
+
+import androidx.appcompat.app.AlertDialog;
+
+import com.winlator.R;
+import com.winlator.container.Container;
+import com.winlator.container.DXWrappers;
+import com.winlator.container.GraphicsDevice;
+import com.winlator.container.GraphicsDrivers;
+import com.winlator.container.GraphicsProfile;
+import com.winlator.core.AppUtils;
+import com.winlator.core.GPUHelper;
+import com.winlator.widget.FrameRating;
+
+import java.util.ArrayList;
+
+public final class GraphicsProfileDialog {
+    private static final int[] FRAME_CAPS = {GraphicsProfile.RECOMMENDED_FRAME_CAP, 0, 30, 45, 60};
+    private final AlertDialog dialog;
+
+    public GraphicsProfileDialog(Activity activity, Container container, GraphicsDevice device) {
+        View view = activity.getLayoutInflater().inflate(R.layout.winblow_graphics_dialog, null);
+        TextView hardware = view.findViewById(R.id.TVGraphicsHardware);
+        String gpuName = device.renderer.isEmpty() ? activity.getString(R.string.winblow_gpu_unknown) : device.renderer;
+        String vulkan = device.vulkanVersion == 0 ? activity.getString(R.string.winblow_vulkan_unavailable) :
+            GPUHelper.vkVersionMajor(device.vulkanVersion)+"."+GPUHelper.vkVersionMinor(device.vulkanVersion);
+        hardware.setText(activity.getString(R.string.winblow_graphics_hardware, gpuName, vulkan));
+
+        ArrayList<GraphicsProfile> profiles = new ArrayList<>();
+        ArrayList<String> labels = new ArrayList<>();
+        String[] names = activity.getResources().getStringArray(R.array.winblow_graphics_profiles);
+        for (GraphicsProfile profile : GraphicsProfile.values()) {
+            if (profile.isAvailable(device.vulkanVersion)) {
+                profiles.add(profile);
+                labels.add(names[profile.ordinal()]);
+            }
+        }
+        Spinner presets = view.findViewById(R.id.SGraphicsProfile);
+        presets.setAdapter(new ArrayAdapter<>(activity, android.R.layout.simple_spinner_dropdown_item, labels));
+        Spinner resolution = view.findViewById(R.id.SGraphicsResolution);
+        String[] sizes = {"", container.getScreenSize(), "800x600", "960x540", "1280x720", "1600x900", "1920x1080"};
+        Spinner cap = view.findViewById(R.id.SGraphicsFrameLimit);
+        TextView preview = view.findViewById(R.id.TVGraphicsPreview);
+        CheckBox showFps = view.findViewById(R.id.CBGraphicsShowFPS);
+        showFps.setChecked(container.getHUDMode() != FrameRating.Mode.DISABLED.ordinal());
+        presets.setOnItemSelectedListener(new AdapterView.OnItemSelectedListener() {
+            @Override
+            public void onItemSelected(AdapterView<?> parent, View item, int position, long id) {
+                GraphicsProfile.Settings settings = device.resolve(profiles.get(position), GraphicsProfile.RECOMMENDED_FRAME_CAP);
+                String[] drivers = GraphicsDrivers.parseIdentifiers(settings.drivers);
+                preview.setText(activity.getString(R.string.winblow_graphics_preview,
+                    GraphicsDrivers.getName(drivers[0]), GraphicsDrivers.getName(drivers[1]),
+                    DXWrappers.getName(settings.wrapper), settings.resolution.replace("x", "×")));
+                cap.setEnabled(DXWrappers.DXVK.equals(settings.wrapper));
+            }
+
+            @Override
+            public void onNothingSelected(AdapterView<?> parent) {}
+        });
+        dialog = new AlertDialog.Builder(activity)
+            .setTitle(R.string.winblow_graphics_presets)
+            .setView(view)
+            .setNegativeButton(android.R.string.cancel, null)
+            .setPositiveButton(R.string.winblow_apply_graphics, (dialog, button) -> {
+                GraphicsProfile.Settings settings = device.resolve(profiles.get(presets.getSelectedItemPosition()),
+                    FRAME_CAPS[cap.getSelectedItemPosition()]);
+                String size = sizes[resolution.getSelectedItemPosition()];
+                container.setScreenSize(size.isEmpty() ? settings.resolution : size);
+                container.setGraphicsDriver(settings.drivers);
+                container.setGraphicsDriverConfig("");
+                container.setDXWrapper(settings.wrapper);
+                container.setDXWrapperConfig(settings.wrapperConfig);
+                if (!showFps.isChecked()) container.setHUDMode((byte)FrameRating.Mode.DISABLED.ordinal());
+                else if (container.getHUDMode() == FrameRating.Mode.DISABLED.ordinal()) {
+                    container.setHUDMode((byte)FrameRating.Mode.SIMPLE.ordinal());
+                }
+                container.saveData();
+                AppUtils.showToast(activity, R.string.winblow_graphics_applied);
+            })
+            .create();
+    }
+
+    public void show() {
+        dialog.show();
+    }
+}
