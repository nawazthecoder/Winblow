new file mode 100644
index 0000000..5d94c04
--- /dev/null
+++ b/app/src/main/java/com/winlator/container/GraphicsDevice.java
@@ -0,0 +1,44 @@
+package com.winlator.container;
+
+import android.app.ActivityManager;
+import android.content.Context;
+import android.content.pm.FeatureInfo;
+import android.content.pm.PackageManager;
+
+import com.winlator.core.GPUHelper;
+
+public final class GraphicsDevice {
+    public final String renderer;
+    public final int vulkanVersion;
+    public final boolean lowMemory;
+    private final int adrenoModel;
+
+    private GraphicsDevice(String renderer, int vulkanVersion, boolean lowMemory, int adrenoModel) {
+        this.renderer = renderer;
+        this.vulkanVersion = vulkanVersion;
+        this.lowMemory = lowMemory;
+        this.adrenoModel = adrenoModel;
+    }
+
+    public static GraphicsDevice detect(Context context) {
+        ActivityManager manager = (ActivityManager)context.getSystemService(Context.ACTIVITY_SERVICE);
+        ActivityManager.MemoryInfo memory = new ActivityManager.MemoryInfo();
+        manager.getMemoryInfo(memory);
+        boolean lowMemory = manager.isLowRamDevice() || memory.totalMem < 5L * 1024 * 1024 * 1024;
+        String renderer = GPUHelper.glGetRenderer(context);
+        return new GraphicsDevice(renderer, vulkanVersion(context), lowMemory, GPUHelper.adrenoModelId(renderer));
+    }
+
+    public static int vulkanVersion(Context context) {
+        FeatureInfo[] features = context.getPackageManager().getSystemAvailableFeatures();
+        if (features == null) return 0;
+        for (FeatureInfo feature : features) {
+            if (PackageManager.FEATURE_VULKAN_HARDWARE_VERSION.equals(feature.name)) return feature.version;
+        }
+        return 0;
+    }
+
+    public GraphicsProfile.Settings resolve(GraphicsProfile profile, int frameCap) {
+        return profile.resolve(vulkanVersion, adrenoModel, lowMemory, frameCap);
+    }
+}
