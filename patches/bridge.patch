--- /dev/null
+++ b/app/src/main/java/com/winlator/renderer/GraphicsBridge.java
@@ -0,0 +1,92 @@
+package com.winlator.renderer;
+
+import com.winlator.core.GPUHelper;
+import java.util.concurrent.atomic.AtomicLongArray;
+import java.util.concurrent.FutureTask;
+import java.util.concurrent.TimeUnit;
+
+/** Winblow-owned presentation bridge; all GL objects belong to one client's context. */
+public final class GraphicsBridge implements AutoCloseable {
+    private long context;
+    private long nativePtr;
+    private static final AtomicLongArray counters = new AtomicLongArray(5);
+    private static volatile int lastError;
+    private static FutureTask<Integer> testTask;
+
+    static { System.loadLibrary("winlator"); }
+
+    private GraphicsBridge(long context, long nativePtr) {
+        this.context = context;
+        this.nativePtr = nativePtr;
+    }
+
+    public static GraphicsBridge create() {
+        long context = GPUHelper.createOffscreenEGLContext(true);
+        if (context == 0) return null;
+        long ptr = nativeCreate();
+        GPUHelper.releaseOffscreenEGLContext(context);
+        if (ptr == 0) {
+            GPUHelper.destroyOffscreenEGLContext(context);
+            return null;
+        }
+        return new GraphicsBridge(context, ptr);
+    }
+
+    public boolean begin() {
+        return context != 0 && GPUHelper.makeOffscreenEGLContextCurrent(context);
+    }
+
+    public void end() {
+        if (context != 0) GPUHelper.releaseOffscreenEGLContext(context);
+    }
+
+    public boolean copy(int src, int dst, int sw, int sh, int dw, int dh, int x, int y) {
+        int path = nativeCopy(nativePtr, src, dst, sw, sh, dw, dh, x, y);
+        counters.incrementAndGet(path >= 0 && path <= 3 ? path : 4);
+        if (path < 0) lastError = nativeError(nativePtr);
+        return path >= 0;
+    }
+
+    @Override
+    public void close() {
+        if (context == 0) return;
+        boolean current = begin();
+        nativeDestroy(nativePtr, current);
+        nativePtr = 0;
+        GPUHelper.destroyOffscreenEGLContext(context);
+        context = 0;
+    }
+
+    /** Uses a separate unshared context so the check can run outside a desktop. */
+    public static int selfTest() {
+        long context = GPUHelper.createOffscreenEGLContext(false);
+        if (context == 0) return 0;
+        try { return nativeSelfTest(); }
+        finally { GPUHelper.destroyOffscreenEGLContext(context); }
+    }
+
+    public static synchronized int checkedModes() {
+        if (testTask == null) {
+            testTask = new FutureTask<>(GraphicsBridge::selfTest);
+            Thread worker = new Thread(testTask, "winblow-copy-self-test");
+            worker.setDaemon(true);
+            worker.start();
+        }
+        try { return testTask.get(2, TimeUnit.SECONDS); }
+        catch (InterruptedException e) { Thread.currentThread().interrupt(); }
+        catch (Exception e) { /* A failed or slow vendor check never blocks desktop creation. */ }
+        return -1;
+    }
+
+    public static String statistics() {
+        return "Image copies: "+counters.get(1)+"\nFramebuffer blits: "+counters.get(2)+
+            "\nCPU readbacks: "+counters.get(3)+"\nFailed copies: "+counters.get(4)+
+            "\nLast copy error: 0x"+Integer.toHexString(lastError);
+    }
+
+    private static native long nativeCreate();
+    private static native int nativeCopy(long ptr, int src, int dst, int sw, int sh, int dw, int dh, int x, int y);
+    private static native int nativeError(long ptr);
+    private static native void nativeDestroy(long ptr, boolean current);
+    private static native int nativeSelfTest();
+}
