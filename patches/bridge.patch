diff --git a/app/src/main/cpp/winlator/src/graphics_bridge.c b/app/src/main/cpp/winlator/src/graphics_bridge.c
new file mode 100644
index 0000000..c0db376
--- /dev/null
+++ b/app/src/main/cpp/winlator/src/graphics_bridge.c
@@ -0,0 +1,205 @@
+#include "graphics_bridge.h"
+#include <EGL/egl.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define WB_READBACK_LIMIT (32u * 1024u * 1024u)
+
+struct WBGraphicsBridge {
+    GLuint framebuffers[2];
+    PFNGLCOPYIMAGESUBDATAPROC copy_image;
+    bool image_failed, blit_failed;
+    unsigned char *readback;
+    size_t readback_size;
+    GLenum last_error;
+};
+
+bool wb_copy_region(int sw, int sh, int dw, int dh, int x, int y, WBCopyRegion *r) {
+    if (!r || sw <= 0 || sh <= 0 || dw <= 0 || dh <= 0) return false;
+    /* Work in 64 bits so even untrusted INT_MIN offsets cannot overflow. */
+    int64_t sx = x < 0 ? -(int64_t)x : 0, sy = y < 0 ? -(int64_t)y : 0;
+    int64_t dx = x > 0 ? x : 0, dy = y > 0 ? y : 0;
+    int64_t w = sw - sx, h = sh - sy;
+    if ((int64_t)dw - dx < w) w = (int64_t)dw - dx;
+    if ((int64_t)dh - dy < h) h = (int64_t)dh - dy;
+    memset(r, 0, sizeof(*r));
+    if (w <= 0 || h <= 0) return true;
+    *r = (WBCopyRegion){(int)sx, (int)sy, (int)dx, (int)dy, (int)w, (int)h};
+    return true;
+}
+
+static void clear_errors(void) {
+    /* Bound the loop in case a driver keeps reporting context loss. */
+    for (int i = 0; i < 16 && glGetError() != GL_NO_ERROR; i++) {}
+}
+
+static bool has_extension(const char *wanted) {
+    GLint count = 0;
+    glGetIntegerv(GL_NUM_EXTENSIONS, &count);
+    for (GLint i = 0; i < count; i++) {
+        const char *value = (const char *)glGetStringi(GL_EXTENSIONS, i);
+        if (value && !strcmp(value, wanted)) return true;
+    }
+    return false;
+}
+
+WBGraphicsBridge *wb_graphics_create(void) {
+    if (eglGetCurrentContext() == EGL_NO_CONTEXT) return NULL;
+    WBGraphicsBridge *b = calloc(1, sizeof(*b));
+    if (!b) return NULL;
+    clear_errors();
+    glGenFramebuffers(2, b->framebuffers);
+    if (!b->framebuffers[0] || !b->framebuffers[1] || glGetError() != GL_NO_ERROR) {
+        wb_graphics_destroy(b, true);
+        return NULL;
+    }
+    GLint major = 0, minor = 0;
+    glGetIntegerv(GL_MAJOR_VERSION, &major);
+    glGetIntegerv(GL_MINOR_VERSION, &minor);
+    if (major > 3 || (major == 3 && minor >= 2))
+        b->copy_image = (PFNGLCOPYIMAGESUBDATAPROC)eglGetProcAddress("glCopyImageSubData");
+    else if (has_extension("GL_EXT_copy_image"))
+        b->copy_image = (PFNGLCOPYIMAGESUBDATAPROC)eglGetProcAddress("glCopyImageSubDataEXT");
+    else if (has_extension("GL_OES_copy_image"))
+        b->copy_image = (PFNGLCOPYIMAGESUBDATAPROC)eglGetProcAddress("glCopyImageSubDataOES");
+    clear_errors();
+    return b;
+}
+
+void wb_graphics_destroy(WBGraphicsBridge *b, bool current) {
+    if (!b) return;
+    if (current) glDeleteFramebuffers(2, b->framebuffers);
+    free(b->readback);
+    free(b);
+}
+
+GLenum wb_graphics_error(const WBGraphicsBridge *b) {
+    return b ? b->last_error : GL_INVALID_OPERATION;
+}
+
+int wb_graphics_copy(WBGraphicsBridge *b, GLuint src, GLuint dst, const WBCopyRegion *r, int mode) {
+    if (!b || !r || !src || !dst || src == dst || r->width < 0 || r->height < 0) return WB_COPY_FAILED;
+    if (!r->width || !r->height) return WB_COPY_EMPTY;
+    int result = WB_COPY_FAILED;
+    b->last_error = GL_NO_ERROR;
+    clear_errors();
+    if (mode == WB_COPY_AUTO && b->copy_image && !b->image_failed) {
+        b->copy_image(src, GL_TEXTURE_2D, 0, r->src_x, r->src_y, 0,
+                      dst, GL_TEXTURE_2D, 0, r->dst_x, r->dst_y, 0, r->width, r->height, 1);
+        GLenum error = glGetError();
+        if (error == GL_NO_ERROR) {
+            glFlush();
+            return WB_COPY_IMAGE;
+        }
+        b->last_error = error;
+        b->image_failed = true; /* Stop retrying a broken fast path every frame. */
+    }
+
+    GLint previous_read = 0, previous_draw = 0, previous_texture = 0;
+    GLint pack = 0, unpack = 0, pack_buffer = 0, unpack_buffer = 0;
+    GLint pack_row = 0, pack_rows = 0, pack_pixels = 0, unpack_row = 0, unpack_rows = 0, unpack_pixels = 0;
+    GLboolean scissor = glIsEnabled(GL_SCISSOR_TEST);
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &previous_read);
+    glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &previous_draw);
+    glGetIntegerv(GL_TEXTURE_BINDING_2D, &previous_texture);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, b->framebuffers[0]);
+    glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, src, 0);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, b->framebuffers[1]);
+    glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, dst, 0);
+    bool readable = glCheckFramebufferStatus(GL_READ_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+    bool writable = glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+    if (readable && writable && mode != WB_FORCE_READBACK && !b->blit_failed) {
+        glDisable(GL_SCISSOR_TEST);
+        glBlitFramebuffer(r->src_x, r->src_y, r->src_x + r->width, r->src_y + r->height,
+                          r->dst_x, r->dst_y, r->dst_x + r->width, r->dst_y + r->height,
+                          GL_COLOR_BUFFER_BIT, GL_NEAREST);
+        GLenum error = glGetError();
+        if (error == GL_NO_ERROR) result = WB_COPY_BLIT;
+        else { b->last_error = error; b->blit_failed = true; }
+    }
+    if (result == WB_COPY_FAILED && readable) {
+        size_t width = (size_t)r->width, height = (size_t)r->height;
+        if (width <= WB_READBACK_LIMIT / 4 && height <= WB_READBACK_LIMIT / (width * 4)) {
+            size_t bytes = width * height * 4;
+            if (bytes > b->readback_size) {
+                unsigned char *data = realloc(b->readback, bytes);
+                if (data) { b->readback = data; b->readback_size = bytes; }
+            }
+            if (b->readback_size >= bytes) {
+                glGetIntegerv(GL_PACK_ALIGNMENT, &pack); glGetIntegerv(GL_UNPACK_ALIGNMENT, &unpack);
+                glGetIntegerv(GL_PIXEL_PACK_BUFFER_BINDING, &pack_buffer); glGetIntegerv(GL_PIXEL_UNPACK_BUFFER_BINDING, &unpack_buffer);
+                glGetIntegerv(GL_PACK_ROW_LENGTH, &pack_row); glGetIntegerv(GL_PACK_SKIP_ROWS, &pack_rows);
+                glGetIntegerv(GL_PACK_SKIP_PIXELS, &pack_pixels); glGetIntegerv(GL_UNPACK_ROW_LENGTH, &unpack_row);
+                glGetIntegerv(GL_UNPACK_SKIP_ROWS, &unpack_rows); glGetIntegerv(GL_UNPACK_SKIP_PIXELS, &unpack_pixels);
+                glBindBuffer(GL_PIXEL_PACK_BUFFER, 0); glBindBuffer(GL_PIXEL_UNPACK_BUFFER, 0);
+                glPixelStorei(GL_PACK_ALIGNMENT, 1); glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+                glPixelStorei(GL_PACK_ROW_LENGTH, 0); glPixelStorei(GL_PACK_SKIP_ROWS, 0); glPixelStorei(GL_PACK_SKIP_PIXELS, 0);
+                glPixelStorei(GL_UNPACK_ROW_LENGTH, 0); glPixelStorei(GL_UNPACK_SKIP_ROWS, 0); glPixelStorei(GL_UNPACK_SKIP_PIXELS, 0);
+                clear_errors();
+                glReadPixels(r->src_x, r->src_y, r->width, r->height, GL_RGBA, GL_UNSIGNED_BYTE, b->readback);
+                GLenum error = glGetError();
+                if (error == GL_NO_ERROR) {
+                    glBindTexture(GL_TEXTURE_2D, dst);
+                    glTexSubImage2D(GL_TEXTURE_2D, 0, r->dst_x, r->dst_y, r->width, r->height,
+                                    GL_RGBA, GL_UNSIGNED_BYTE, b->readback);
+                    error = glGetError();
+                    if (error == GL_NO_ERROR) result = WB_COPY_READBACK;
+                }
+                if (error != GL_NO_ERROR) b->last_error = error;
+                glPixelStorei(GL_PACK_ALIGNMENT, pack); glPixelStorei(GL_UNPACK_ALIGNMENT, unpack);
+                glPixelStorei(GL_PACK_ROW_LENGTH, pack_row); glPixelStorei(GL_PACK_SKIP_ROWS, pack_rows);
+                glPixelStorei(GL_PACK_SKIP_PIXELS, pack_pixels); glPixelStorei(GL_UNPACK_ROW_LENGTH, unpack_row);
+                glPixelStorei(GL_UNPACK_SKIP_ROWS, unpack_rows); glPixelStorei(GL_UNPACK_SKIP_PIXELS, unpack_pixels);
+                glBindBuffer(GL_PIXEL_PACK_BUFFER, pack_buffer); glBindBuffer(GL_PIXEL_UNPACK_BUFFER, unpack_buffer);
+            }
+            else b->last_error = GL_OUT_OF_MEMORY;
+        }
+        else b->last_error = GL_OUT_OF_MEMORY;
+    }
+    else if (!readable || !writable) b->last_error = GL_INVALID_FRAMEBUFFER_OPERATION;
+    glFramebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, 0, 0);
+    glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, 0, 0);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, previous_read);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, previous_draw);
+    glBindTexture(GL_TEXTURE_2D, previous_texture);
+    if (scissor) glEnable(GL_SCISSOR_TEST);
+    if (result >= 0) glFlush();
+    return result;
+}
+
+int wb_graphics_self_test(WBGraphicsBridge *b, int mode) {
+    GLuint textures[2] = {0}, framebuffer = 0;
+    const unsigned char expected[4] = {37, 91, 173, 255};
+    unsigned char pixel[4] = {0};
+    glGenTextures(2, textures);
+    for (int i = 0; i < 2; i++) {
+        glBindTexture(GL_TEXTURE_2D, textures[i]);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, 1, 1, 0, GL_RGBA, GL_UNSIGNED_BYTE, i == 0 ? expected : pixel);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    }
+    WBCopyRegion region = {0, 0, 0, 0, 1, 1};
+    int path = wb_graphics_copy(b, textures[0], textures[1], &region, mode);
+    glGenFramebuffers(1, &framebuffer);
+    glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, textures[1], 0);
+    bool complete = glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE;
+    if (complete) glReadPixels(0, 0, 1, 1, GL_RGBA, GL_UNSIGNED_BYTE, pixel);
+    bool success = path >= 0 && complete && glGetError() == GL_NO_ERROR && !memcmp(expected, pixel, sizeof(pixel));
+    glBindFramebuffer(GL_FRAMEBUFFER, 0); glBindTexture(GL_TEXTURE_2D, 0);
+    glDeleteFramebuffers(1, &framebuffer); glDeleteTextures(2, textures);
+    return success ? path : WB_COPY_FAILED;
+}
+
+int wb_graphics_validate(WBGraphicsBridge *b) {
+    if (!b) return 0;
+    int mask = 0;
+    int path = wb_graphics_self_test(b, WB_COPY_AUTO);
+    if (path > 0) mask |= 1 << (path - 1);
+    else b->image_failed = true;
+    path = wb_graphics_self_test(b, WB_FORCE_BLIT);
+    if (path > 0) mask |= 1 << (path - 1);
+    if (path != WB_COPY_BLIT) b->blit_failed = true;
+    path = wb_graphics_self_test(b, WB_FORCE_READBACK);
+    if (path == WB_COPY_READBACK) mask |= 4;
+    return mask;
+}
diff --git a/app/src/main/cpp/winlator/src/graphics_bridge_jni.c b/app/src/main/cpp/winlator/src/graphics_bridge_jni.c
new file mode 100644
index 0000000..f22c18b
--- /dev/null
+++ b/app/src/main/cpp/winlator/src/graphics_bridge_jni.c
@@ -0,0 +1,39 @@
+#include <jni.h>
+#include "graphics_bridge.h"
+
+JNIEXPORT jlong JNICALL
+Java_com_winlator_renderer_GraphicsBridge_nativeCreate(JNIEnv *env, jclass cls) {
+    WBGraphicsBridge *b = wb_graphics_create();
+    if (b && !wb_graphics_validate(b)) {
+        wb_graphics_destroy(b, true);
+        return 0;
+    }
+    return (jlong)b;
+}
+
+JNIEXPORT jint JNICALL
+Java_com_winlator_renderer_GraphicsBridge_nativeCopy(JNIEnv *env, jclass cls, jlong ptr,
+        jint src, jint dst, jint sw, jint sh, jint dw, jint dh, jint x, jint y) {
+    WBCopyRegion r;
+    if (!wb_copy_region(sw, sh, dw, dh, x, y, &r)) return WB_COPY_FAILED;
+    return wb_graphics_copy((WBGraphicsBridge *)ptr, src, dst, &r, WB_COPY_AUTO);
+}
+
+JNIEXPORT jint JNICALL
+Java_com_winlator_renderer_GraphicsBridge_nativeError(JNIEnv *env, jclass cls, jlong ptr) {
+    return wb_graphics_error((WBGraphicsBridge *)ptr);
+}
+
+JNIEXPORT void JNICALL
+Java_com_winlator_renderer_GraphicsBridge_nativeDestroy(JNIEnv *env, jclass cls, jlong ptr, jboolean current) {
+    wb_graphics_destroy((WBGraphicsBridge *)ptr, current);
+}
+
+JNIEXPORT jint JNICALL
+Java_com_winlator_renderer_GraphicsBridge_nativeSelfTest(JNIEnv *env, jclass cls) {
+    WBGraphicsBridge *b = wb_graphics_create();
+    if (!b) return 0;
+    int mask = wb_graphics_validate(b);
+    wb_graphics_destroy(b, true);
+    return mask;
+}
diff --git a/app/src/main/cpp/winlator/src/graphics_vulkan.c b/app/src/main/cpp/winlator/src/graphics_vulkan.c
new file mode 100644
index 0000000..075f277
--- /dev/null
+++ b/app/src/main/cpp/winlator/src/graphics_vulkan.c
@@ -0,0 +1,80 @@
+#include <jni.h>
+#include <stdlib.h>
+#include <string.h>
+#include <dlfcn.h>
+#define VK_NO_PROTOTYPES 1
+#include <vulkan/vulkan.h>
+#include "winlator.h"
+
+/* Probe the Android Vulkan implementation used by Vortek, never a guessed GPU model. */
+JNIEXPORT jlongArray JNICALL
+Java_com_winlator_core_GPUHelper_queryVulkanCapabilities(JNIEnv *env, jclass cls) {
+    jlong values[12] = {0};
+    VkInstance instance = VK_NULL_HANDLE;
+    VkExtensionProperties *extensions = NULL;
