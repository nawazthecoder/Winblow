+        for (int j = 0; j < 6; j++)
+            if (!strcmp(extensions[i].extensionName, required[j])) values[7] |= 1L << j;
+done:
+    free(extensions);
+    if (instance && destroy) destroy(instance, NULL);
+    if (library) dlclose(library);
+    jlongArray array = (*env)->NewLongArray(env, 12);
+    if (array) (*env)->SetLongArrayRegion(env, array, 0, 12, values);
+    return array;
+}
