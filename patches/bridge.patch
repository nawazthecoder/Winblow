+#ifndef WINBLOW_GRAPHICS_BRIDGE_H
+#define WINBLOW_GRAPHICS_BRIDGE_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <GLES3/gl32.h>
+
+/* Each bridge belongs to one EGL context. No GL objects are shared between bridges. */
+typedef struct WBGraphicsBridge WBGraphicsBridge;
+typedef struct {
+    int src_x, src_y, dst_x, dst_y, width, height;
+} WBCopyRegion;
+
+enum {
+    WB_COPY_FAILED = -1, WB_COPY_EMPTY = 0, WB_COPY_IMAGE = 1,
+    WB_COPY_BLIT = 2, WB_COPY_READBACK = 3,
+    WB_COPY_AUTO = 0, WB_FORCE_BLIT = 1, WB_FORCE_READBACK = 2
+};
+
+bool wb_copy_region(int src_width, int src_height, int dst_width, int dst_height,
+                    int x, int y, WBCopyRegion *region);
+WBGraphicsBridge *wb_graphics_create(void);
+void wb_graphics_destroy(WBGraphicsBridge *bridge, bool context_current);
+int wb_graphics_copy(WBGraphicsBridge *bridge, GLuint src, GLuint dst,
+                     const WBCopyRegion *region, int mode);
+GLenum wb_graphics_error(const WBGraphicsBridge *bridge);
+/* 1x1 RGBA sentinel, checked through an actual texture copy and glReadPixels. */
+int wb_graphics_self_test(WBGraphicsBridge *bridge, int mode);
+int wb_graphics_validate(WBGraphicsBridge *bridge);
+
+#endif
