+    if ((result != VK_SUCCESS && result != VK_INCOMPLETE) || !count || !device) goto done;
+    VkPhysicalDeviceProperties properties;
+    VkPhysicalDeviceFeatures features;
+    properties_fn(device, &properties);
+    features_fn(device, &features);
+    values[0] = properties.apiVersion;
+    values[1] = properties.limits.maxPushConstantsSize;
+    values[2] = features.shaderInt16 == VK_TRUE;
+    values[3] = features.shaderInt64 == VK_TRUE;
+    values[8] = properties.vendorID;
+    values[9] = properties.deviceID;
+    values[10] = properties.limits.maxImageDimension2D;
+    values[11] = properties.driverVersion;
+    if (application.apiVersion >= VK_API_VERSION_1_2 && properties.apiVersion >= VK_API_VERSION_1_2) {
+        PFN_vkGetPhysicalDeviceFeatures2 query = (PFN_vkGetPhysicalDeviceFeatures2)get_proc(instance, "vkGetPhysicalDeviceFeatures2");
+        if (query) {
+            VkPhysicalDeviceVulkan12Features features12 = {.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES};
+            VkPhysicalDeviceFeatures2 all = {.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2, .pNext = &features12};
+            query(device, &all);
+            values[4] = features12.shaderInt8 == VK_TRUE;
+            values[5] = features12.descriptorIndexing && features12.runtimeDescriptorArray &&
+                features12.descriptorBindingPartiallyBound && features12.descriptorBindingVariableDescriptorCount &&
+                features12.shaderSampledImageArrayNonUniformIndexing;
+            values[6] = features12.scalarBlockLayout == VK_TRUE;
+        }
+    }
+    count = 0;
+    if (extensions_fn(device, NULL, &count, NULL) != VK_SUCCESS || !count || count > 4096) goto done;
