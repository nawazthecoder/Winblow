diff --git a/app/src/main/java/com/winlator/container/GraphicsCapabilities.java b/app/src/main/java/com/winlator/container/GraphicsCapabilities.java
new file mode 100644
index 0000000..7af341a
--- /dev/null
+++ b/app/src/main/java/com/winlator/container/GraphicsCapabilities.java
@@ -0,0 +1,39 @@
+package com.winlator.container;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/** Conservative preflight for the system Vulkan path. A passing check is not a game guarantee. */
+public final class GraphicsCapabilities {
+    public static final int VULKAN_1_3 = (1 << 22) | (3 << 12);
+    public final int apiVersion, pushConstants, maxImageDimension, extensionMask;
+    public final boolean int16, int64, int8, descriptorIndexing, scalarLayout;
+    public final long vendorId, deviceId, driverVersion;
+
+    public GraphicsCapabilities(long[] data) {
+        if (data == null || data.length != 12) data = new long[12];
+        apiVersion = (int)data[0]; pushConstants = (int)data[1];
+        int16 = data[2] != 0; int64 = data[3] != 0; int8 = data[4] != 0;
+        descriptorIndexing = data[5] != 0; scalarLayout = data[6] != 0;
+        extensionMask = (int)data[7]; vendorId = data[8]; deviceId = data[9];
+        maxImageDimension = (int)data[10]; driverVersion = data[11];
+    }
+
+    public List<String> modernDxvkBlockers() {
+        List<String> missing = new ArrayList<>();
+        if (apiVersion == 0) { missing.add("System Vulkan probe unavailable"); return missing; }
+        if (apiVersion < VULKAN_1_3) missing.add("Vulkan 1.3 or later");
+        if (pushConstants < 256) missing.add("256-byte push constants");
+        if (!int8) missing.add("8-bit shader integers");
+        if (!int16) missing.add("16-bit shader integers");
+        if (!int64) missing.add("64-bit shader integers");
+        if (!descriptorIndexing) missing.add("Descriptor indexing");
+        if (!scalarLayout) missing.add("Scalar block layout");
+        String[] names = {"VK_KHR_maintenance5", "VK_KHR_maintenance6", "VK_KHR_load_store_op_none",
+            "VK_EXT_depth_clip_enable", "VK_EXT_robustness2", "VK_EXT_transform_feedback"};
+        for (int i = 0; i < names.length; i++) if ((extensionMask & (1 << i)) == 0) missing.add(names[i]);
+        return missing;
+    }
+
+    public boolean supportsModernDxvk() { return modernDxvkBlockers().isEmpty(); }
+}
