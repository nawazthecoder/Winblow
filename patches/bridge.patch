+package com.winlator.contentdialog;
+
+import android.app.Activity;
+import android.content.ClipData;
+import android.content.ClipboardManager;
+import android.content.Context;
+import android.os.Build;
+import android.os.Handler;
+import android.os.Looper;
+import android.widget.ScrollView;
+import android.widget.TextView;
+import androidx.appcompat.app.AlertDialog;
+import com.winlator.R;
+import com.winlator.container.Container;
+import com.winlator.container.GraphicsCapabilities;
+import com.winlator.container.GraphicsDevice;
+import com.winlator.container.GraphicsProfile;
+import com.winlator.core.GPUHelper;
+import com.winlator.renderer.GraphicsBridge;
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+public final class GraphicsCheckDialog {
+    private static String version(int value) {
+        return value == 0 ? "unavailable" : GPUHelper.vkVersionMajor(value)+"."+
+            GPUHelper.vkVersionMinor(value)+"."+GPUHelper.vkVersionPatch(value);
+    }
+
+    private static String report(Activity activity, Container container, GraphicsDevice device) throws Exception {
+        GraphicsCapabilities caps = GPUHelper.graphicsCapabilities();
+        int modes = GraphicsBridge.checkedModes();
+        GraphicsProfile.Settings recommended = device.resolve(GraphicsProfile.AUTO, GraphicsProfile.RECOMMENDED_FRAME_CAP);
+        JSONObject result = new JSONObject();
+        result.put("winblowVersion", "0.3.0");
+        result.put("androidVersion", Build.VERSION.RELEASE);
+        result.put("gpu", device.renderer);
+        result.put("lowMemoryPreset", device.lowMemory);
+        result.put("advertisedVulkan", version(GraphicsDevice.advertisedVulkanVersion(activity)));
+        result.put("probedSystemVulkan", version(caps.apiVersion));
+        result.put("systemDriverVersionRaw", caps.driverVersion);
+        result.put("pushConstantBytes", caps.pushConstants);
+        result.put("maximumTextureDimension", caps.maxImageDimension);
+        result.put("systemDxvk3PreflightMissing", new JSONArray(caps.modernDxvkBlockers()));
+        result.put("copyCheckCompleted", modes >= 0);
+        result.put("imageCopyPassed", modes >= 0 && (modes & 1) != 0);
+        result.put("framebufferCopyPassed", modes >= 0 && (modes & 2) != 0);
+        result.put("readbackCopyPassed", modes >= 0 && (modes & 4) != 0);
+        result.put("selectedDrivers", container.getGraphicsDriver());
+        result.put("selectedDirectXTranslator", container.getDXWrapper());
+        result.put("selectedResolution", container.getScreenSize());
+        result.put("recommendedDrivers", recommended.drivers);
+        result.put("recommendedDirectXTranslator", recommended.wrapper);
+        result.put("copyCountersThisProcess", GraphicsBridge.statistics());
+        result.put("scope", "Copy checks cover the Android compositor. Vulkan preflight covers the system driver used by Vortek. Custom Turnip and Windows game compatibility require guest testing.");
+        return result.toString(2);
+    }
+
+    public static void show(Activity activity, Container container, GraphicsDevice device) {
+        AlertDialog progress = new AlertDialog.Builder(activity)
+            .setTitle(R.string.winblow_graphics_check)
+            .setMessage(R.string.winblow_graphics_check_running)
+            .setNegativeButton(android.R.string.cancel, null).create();
+        Handler ui = new Handler(Looper.getMainLooper());
+        Runnable timeout = () -> {
+            if (progress.isShowing()) {
+                progress.dismiss();
+                showReport(activity, activity.getString(R.string.winblow_graphics_check_timeout));
+            }
+        };
+        progress.setOnDismissListener(unused -> ui.removeCallbacks(timeout));
+        progress.show();
+        ui.postDelayed(timeout, 6000);
+        Thread worker = new Thread(() -> {
+            String value;
+            try { value = report(activity, container, device); }
+            catch (Exception e) { value = activity.getString(R.string.winblow_graphics_check_failed); }
+            final String text = value;
+            ui.post(() -> {
+                if (progress.isShowing()) {
+                    progress.dismiss();
+                    showReport(activity, text);
+                }
+            });
+        }, "winblow-graphics-report");
+        worker.setDaemon(true);
+        worker.start();
+    }
+
+    private static void showReport(Activity activity, String report) {
+        if (activity.isFinishing() || activity.isDestroyed()) return;
+        ScrollView scroll = new ScrollView(activity);
+        TextView text = new TextView(activity);
+        int pad = (int)(20 * activity.getResources().getDisplayMetrics().density);
+        text.setPadding(pad, pad, pad, pad);
+        text.setText(report);
+        text.setTextSize(12);
+        text.setTextIsSelectable(true);
+        scroll.addView(text);
+        new AlertDialog.Builder(activity).setTitle(R.string.winblow_graphics_check)
+            .setView(scroll).setPositiveButton(android.R.string.ok, null)
+            .setNeutralButton(R.string.winblow_copy_report, (dialog, button) -> {
+                ClipboardManager clipboard = (ClipboardManager)activity.getSystemService(Context.CLIPBOARD_SERVICE);
+                if (clipboard != null) clipboard.setPrimaryClip(ClipData.newPlainText("Winblow graphics report", report));
+            }).show();
+    }
+}
