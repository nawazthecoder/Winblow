+    private void onProgramSelected(Uri uri) {
+        int containerId = importContainerId;
+        importContainerId = 0;
+        if (uri == null || containerId == 0) return;
+
+        Container container = new ContainerManager(this).getContainerById(containerId);
+        if (container == null) {
+            AppUtils.showToast(this, R.string.winblow_desktop_missing);
+            return;
+        }
+
+        preloaderDialog.show(R.string.winblow_importing);
+        new Thread(() -> {
+            try {
+                File imported = WindowsProgramImporter.copy(getApplicationContext(), container, uri);
+                runOnUiThread(() -> {
+                    preloaderDialog.close();
+                    if (!isFinishing() && !isDestroyed()) launchWindowsProgram(container, imported);
+                });
+            }
+            catch (IOException | RuntimeException e) {
+                Log.w("Winblow", "Unable to import the selected program", e);
+                int message = e instanceof WindowsProgramImporter.InvalidProgramException
