+    private void createDesktop(boolean windows10) {
+        Context context = requireContext();
+        ActivityManager activityManager = (ActivityManager)context.getSystemService(Context.ACTIVITY_SERVICE);
+        ActivityManager.MemoryInfo memory = new ActivityManager.MemoryInfo();
+        activityManager.getMemoryInfo(memory);
+        boolean lowMemory = activityManager.isLowRamDevice() || memory.totalMem < 5L * 1024 * 1024 * 1024;
+        boolean adreno = GPUHelper.getAdrenoModelId(context) > 0;
+
+        JSONObject settings = new JSONObject();
+        try {
+            String profile = getString(windows10 ? R.string.winblow_windows10 : R.string.winblow_windows11);
+            settings.put("name", profile + " · " + manager.getNextContainerId());
+            settings.put("windowsVersion", windows10 ? "win10" : "win11");
+            settings.put("screenSize", lowMemory ? "960x540" : Container.DEFAULT_SCREEN_SIZE);
+            settings.put("graphicsDriver", adreno ? GraphicsDrivers.getDefaultDriver(context) : GraphicsDrivers.VORTEK + "," + GraphicsDrivers.VIRGL);
+            settings.put("dxwrapper", adreno ? DXWrappers.DXVK : DXWrappers.WINED3D);
+            settings.put("box64Preset", Box64Preset.CONSERVATIVE);
+        }
+        catch (JSONException e) {
+            AppUtils.showToast(context, R.string.winblow_create_failed);
+            return;
+        }
+
+        preloaderDialog.show(R.string.creating_container);
+        manager.createContainerAsync(settings, container -> {
+            preloaderDialog.close();
+            if (getView() == null) return;
+            if (container == null) AppUtils.showToast(requireContext(), R.string.winblow_create_failed);
+            else loadContainersList();
+        });
+    }
