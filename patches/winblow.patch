diff --git a/app/src/main/java/com/winlator/core/WindowsProgramFile.java b/app/src/main/java/com/winlator/core/WindowsProgramFile.java
new file mode 100644
index 0000000..3f424e5
--- /dev/null
+++ b/app/src/main/java/com/winlator/core/WindowsProgramFile.java
@@ -0,0 +1,51 @@
+package com.winlator.core;
+
+import java.io.File;
+import java.io.IOException;
+import java.io.RandomAccessFile;
+import java.util.Locale;
+
+public final class WindowsProgramFile {
+    private static final long COMPOUND_DOCUMENT_MAGIC = 0xd0cf11e0a1b11ae1L;
+
+    private WindowsProgramFile() {}
+
+    public static String safeFilename(String displayName) {
+        if (displayName == null) return null;
+        String lowerName = displayName.toLowerCase(Locale.ROOT);
+        if (!lowerName.endsWith(".exe") && !lowerName.endsWith(".msi")) return null;
+
+        String stem = displayName.substring(0, displayName.length() - 4)
+            .replaceAll("[\\p{Cntrl}<>:\"/\\\\|?*]", "_")
+            .trim();
+        if (stem.codePointCount(0, stem.length()) > 60) stem = stem.substring(0, stem.offsetByCodePoints(0, 60));
+        stem = stem.replaceAll("[. ]+$", "");
+        if (stem.isEmpty() || stem.matches("(?i)^(CON|PRN|AUX|NUL|COM[1-9]|LPT[1-9])(?:\\..*)?$")) {
+            stem = "program_" + stem;
+        }
+        return stem + lowerName.substring(lowerName.length() - 4);
+    }
+
+    public static boolean isMsi(String filename) {
+        return filename.toLowerCase(Locale.ROOT).endsWith(".msi");
+    }
+
+    public static boolean matchesFormat(File file) throws IOException {
+        try (RandomAccessFile data = new RandomAccessFile(file, "r")) {
+            if (isMsi(file.getName())) {
+                return data.length() >= 512 && data.readLong() == COMPOUND_DOCUMENT_MAGIC;
+            }
+            if (data.length() < 64 || data.readUnsignedShort() != 0x4d5a) return false;
+            data.seek(0x3c);
+            long peOffset = Integer.toUnsignedLong(Integer.reverseBytes(data.readInt()));
+            if (peOffset < 64 || peOffset > data.length() - 24) return false;
+            data.seek(peOffset);
+            if (data.readInt() != 0x50450000) return false;
+            int machine = Short.toUnsignedInt(Short.reverseBytes(data.readShort()));
+            if (machine != 0x014c && machine != 0x8664) return false;
+            data.seek(peOffset + 22);
+            int flags = Short.toUnsignedInt(Short.reverseBytes(data.readShort()));
+            return (flags & 0x0002) != 0 && (flags & 0x2000) == 0;
+        }
+    }
+}
diff --git a/app/src/main/java/com/winlator/core/WindowsProgramImporter.java b/app/src/main/java/com/winlator/core/WindowsProgramImporter.java
new file mode 100644
index 0000000..26d44d5
--- /dev/null
+++ b/app/src/main/java/com/winlator/core/WindowsProgramImporter.java
@@ -0,0 +1,59 @@
+package com.winlator.core;
+
+import android.content.ContentResolver;
+import android.content.Context;
+import android.database.Cursor;
+import android.net.Uri;
+import android.provider.OpenableColumns;
+
+import com.winlator.container.Container;
+
+import java.io.File;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.file.Files;
+
+public final class WindowsProgramImporter {
+    public static final class InvalidProgramException extends IOException {
+        InvalidProgramException() {
+            super("Expected a Windows x86/x64 EXE or MSI");
+        }
+    }
+
+    private WindowsProgramImporter() {}
+
+    public static File copy(Context context, Container container, Uri uri) throws IOException {
+        ContentResolver resolver = context.getContentResolver();
+        String name;
+        try (Cursor cursor = resolver.query(uri, new String[]{OpenableColumns.DISPLAY_NAME}, null, null, null)) {
+            if (cursor == null || !cursor.moveToFirst()) throw new IOException("The document is unavailable");
+            name = WindowsProgramFile.safeFilename(cursor.getString(0));
+        }
+        if (name == null) throw new InvalidProgramException();
+
+        File drive = new File(container.getRootDir().getCanonicalFile(), ".wine/drive_c");
+        File imports = new File(drive, "WinblowImports");
+        if (!drive.isDirectory() || !imports.equals(imports.getCanonicalFile())) {
+            throw new IOException("Invalid destination drive");
+        }
+        Files.createDirectories(imports.toPath());
+        File folder = Files.createTempDirectory(imports.toPath(), "app-").toFile();
+        File file = new File(folder, name);
+        boolean complete = false;
+        try {
+            try (InputStream input = resolver.openInputStream(uri)) {
+                if (input == null) throw new IOException("The document is unavailable");
+                Files.copy(input, file.toPath());
+            }
+            if (!WindowsProgramFile.matchesFormat(file)) throw new InvalidProgramException();
+            complete = true;
+            return file;
+        }
+        finally {
+            if (!complete) {
+                file.delete();
+                folder.delete();
+            }
+        }
+    }
+}
